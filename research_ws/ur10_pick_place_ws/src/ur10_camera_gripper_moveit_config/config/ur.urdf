  <!-- Attach gripper to UR tool0.
       xyz z = 0.05 m: 0.02 m adapter plate + 0.03 m FTS (force-torque sensor)
       between UR10 flange and Robotiq 3F mount.
       Previously 0.02 (FTS omitted) → gripper went 3 cm too low → tray collision. -->
  <joint name="ur_to_robotiq_mount" type="fixed">
    <parent link="tool0"/>
    <child link="robotiq_palm"/>
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
  </joint>
